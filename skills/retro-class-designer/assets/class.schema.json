{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dofus-lite custom class authoring package v1 (proposed import contract)",
  "description": "Technical compatibility is not balance approval. Only level 200 and the closed v1 effect subset are supported.",
  "type": "object",
  "properties": {
    "format": {
      "const": "dofus-lite-class"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "credits": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "baseClass": {
      "enum": [
        "FECA",
        "OSAMODAS",
        "ENUTROF",
        "SRAM",
        "XELOR",
        "ECAFLIP",
        "ENIRIPSA",
        "IOP",
        "CRA",
        "SADIDA",
        "SACRIEUR",
        "PANDAWA"
      ]
    },
    "profile": {
      "const": "retro-200-v1"
    },
    "design": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "primaryRole": {
          "enum": [
            "damage",
            "control",
            "protection",
            "healing",
            "summoning",
            "placement",
            "support"
          ]
        },
        "secondaryRole": {
          "enum": [
            "damage",
            "control",
            "protection",
            "healing",
            "summoning",
            "placement",
            "support"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "enum": [
              "neutre",
              "terre",
              "feu",
              "eau",
              "air"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 2,
          "maxItems": 3
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 2,
          "maxItems": 4
        },
        "turnLoop": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 3,
          "maxItems": 3
        },
        "intendedRange": {
          "enum": [
            "melee",
            "medium",
            "long"
          ]
        },
        "complexity": {
          "enum": [
            "beginner",
            "intermediate",
            "expert"
          ]
        }
      },
      "required": [
        "identity",
        "theme",
        "primaryRole",
        "secondaryRole",
        "elements",
        "strengths",
        "weaknesses",
        "turnLoop",
        "intendedRange",
        "complexity"
      ],
      "additionalProperties": false
    },
    "artwork": {
      "type": "object",
      "properties": {
        "portrait": {
          "const": "artwork/portrait.png"
        },
        "idle-front": {
          "const": "artwork/idle-front.png"
        },
        "idle-back": {
          "const": "artwork/idle-back.png"
        },
        "walk-front": {
          "const": "artwork/walk-front.png"
        },
        "walk-back": {
          "const": "artwork/walk-back.png"
        },
        "cast-front": {
          "const": "artwork/cast-front.png"
        },
        "cast-back": {
          "const": "artwork/cast-back.png"
        },
        "hit-front": {
          "const": "artwork/hit-front.png"
        },
        "hit-back": {
          "const": "artwork/hit-back.png"
        }
      },
      "required": [
        "portrait",
        "idle-front",
        "idle-back"
      ],
      "additionalProperties": false
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spell"
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
