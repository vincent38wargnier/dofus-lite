{
  "name": "dofus-lite",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "acorn": "^8.17.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/prepare_ruffle.cjs && react-scripts start",
    "build": "node scripts/prepare_ruffle.cjs && react-scripts build",
    "import:client": "node scripts/prepare_ruffle.cjs && python3 scripts/import_dungeon_maps.py && python3 scripts/import_retro_client.py && python3 scripts/import_client_spells.py && python3 scripts/import_client_monsters.py && node scripts/render_retro_assets.cjs --force",
    "render:client": "node scripts/prepare_ruffle.cjs && node scripts/render_retro_assets.cjs --force",
    "test:client": "python3 -m unittest discover -s scripts -p 'test_retro_swf.py'",
    "test:audio": "python3 -m unittest discover -s scripts -p 'test_retro_audio.py'",
    "test:combat-data": "python3 -m unittest discover -s scripts -p 'test*spell*.py'",
    "import:spells": "python3 scripts/import_client_spells.py && node scripts/render_retro_assets.cjs --icons-only",
    "import:maps": "python3 scripts/import_dofus_maps.py generate && python3 scripts/import_dungeon_maps.py && python3 scripts/import_retro_client.py --maps-only && node scripts/render_retro_assets.cjs",
    "test:maps": "python3 -m unittest discover -s scripts -p 'test_*map*.py'",
    "proof:placement": "node scripts/proof_placement.cjs",
    "proof:client": "node scripts/proof_retro.cjs",
    "proof:combat": "node scripts/proof_combat.cjs",
    "proof:audio": "node scripts/proof_audio.cjs",
    "proof:combat-audio": "node scripts/proof_combat_audio.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "import:equipment": "python3 scripts/import_equipment.py && node scripts/render_equipment.cjs",
    "render:equipment": "node scripts/render_equipment.cjs",
    "test:equipment-data": "python3 -m unittest discover -s scripts -p 'test_equipment_import.py'",
    "proof:equipment": "node scripts/proof_equipment.cjs",
    "import:wearables": "python3 scripts/import_retro_client.py --accessories-only",
    "proof:wearables": "node scripts/proof_equipped_sprites.cjs",
    "audit:equipment": "python3 scripts/audit_equipment_catalogue.py",
    "proof:spells": "node scripts/proof_spells.cjs",
    "proof:loadouts": "node scripts/proof_loadouts.cjs",
    "proof:setup": "node scripts/proof_setup.cjs",
    "proof:characteristics": "node scripts/proof_characteristics.cjs",
    "audit:characteristics": "python3 scripts/audit_characteristic_caps.py",
    "proof:parchottage": "node scripts/proof_parchottage.cjs",
    "import:forgemagie": "python3 scripts/import_forgemagie.py && node scripts/render_equipment.cjs --forgemagie",
    "proof:forgemagie": "node scripts/proof_forgemagie.cjs",
    "import:monsters": "python3 scripts/import_client_monsters.py && node scripts/render_retro_assets.cjs --monsters-only",
    "test:monster-data": "python3 -m unittest discover -s scripts -p 'test_client_monsters.py'",
    "proof:kanojedo": "node scripts/proof_kanojedo.cjs",
    "proof:bosses": "node scripts/proof_dungeons.cjs",
    "import:dungeons": "python3 scripts/import_dungeon_maps.py && python3 scripts/import_client_monsters.py && python3 scripts/import_retro_client.py --maps-only && node scripts/render_retro_assets.cjs",
    "proof:dungeons": "node scripts/proof_dungeons.cjs",
    "proof:auto-dungeon": "node scripts/proof_auto_dungeon.cjs",
    "proof:ai-duel": "node scripts/proof_ai_duel.cjs",
    "proof:workshop": "node scripts/proof_workshop.cjs",
    "templates:characters": "node scripts/generate_character_templates.cjs",
    "proof:character-artwork": "node scripts/proof_character_artwork.cjs",
    "ai:audit-logs": "node scripts/audit_ai_logs.cjs",
    "ai:audit-catalogue": "node scripts/audit_ai_catalogue.cjs",
    "ai:benchmark": "node scripts/benchmark_ai.cjs",
    "ai:calibrate": "node scripts/calibrate_ai_profiles.cjs",
    "templates:content": "node scripts/build_content_templates.cjs",
    "validate:content": "node scripts/content-pack.cjs validate",
    "proof:content": "node scripts/proof_content_packages.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "puppeteer-core": "^25.3.0"
  }
}
