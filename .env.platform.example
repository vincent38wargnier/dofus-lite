# Used by compose.yaml; no secrets are needed for password/session generation.
DOMAIN=play.example.com
# Native process: PUBLIC_ORIGIN must exactly match the browser origin.
# PUBLIC_ORIGIN=https://play.example.com
# PORT=3013
# HOST=127.0.0.1
# DATA_DIR=/absolute/persistent/path
# TRUST_PROXY=1 only behind one trusted reverse proxy.
# MongoDB is optional for local development. The deployed site uses this database.
# Keep the actual connection string only in private environment variables.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/
MONGODB_DB=arenaforge
# Large ZIPs stay on the persistent /data volume. Optional alternative: gridfs.
LIBRARY_FILE_STORE=filesystem
